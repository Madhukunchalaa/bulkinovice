datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model InvoiceCategory {
  id                     Int      @id @default(autoincrement())
  label                  String   @unique
  amount                 Decimal  @db.Decimal(12, 2)
  defaultItemDescription String   @default("") @map("default_item_description")
  clients                Client[]
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("invoice_categories")
}

model Client {
  id                Int                @id @default(autoincrement())
  name              String
  gstin             String?            @db.VarChar(15) // GSTIN is 15 chars in India
  address           String?            @db.Text
  email             String?
  phone             String?
  itemDescription   String             @default("") @map("item_description")
  invoiceCategoryId Int                @map("invoice_category_id")
  invoiceCategory   InvoiceCategory    @relation(fields: [invoiceCategoryId], references: [id])
  active            Boolean            @default(true)
  invoices          GeneratedInvoice[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("clients")
}

model GeneratedInvoice {
  id             Int      @id @default(autoincrement())
  clientId       Int?     @map("client_id")
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName     String   @map("client_name")
  clientGstin    String?  @map("client_gstin") @db.VarChar(15)
  clientAddress  String?  @map("client_address") @db.Text
  invoiceNumber  String   @unique @map("invoice_number")
  amount         Decimal  @db.Decimal(12, 2)
  generatedAt    DateTime @default(now()) @map("generated_at")
  pdfPath        String   @map("pdf_path")

  @@map("generated_invoices")
}

model InvoiceSequence {
  id        Int @id @default(autoincrement())
  nextValue Int @default(1) @map("next_value")

  @@map("invoice_sequences")
}
