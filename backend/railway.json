{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "nixpacksPlan": {
      "phases": {
        "install": {
          "aptPkgs": [
            "libnss3",
            "libxss1",
            "libasound2",
            "libatk1.0-0",
            "libatk-bridge2.0-0",
            "libcups2",
            "libdrm2",
            "libxkbcommon0",
            "libxcomposite1",
            "libxdamage1",
            "libxext6",
            "libxfixes3",
            "libxrandr2",
            "libpango-1.0-0",
            "libpangocairo-1.0-0",
            "libgtk-3-0"
          ]
        }
      }
    }
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  }
}

