{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "nixpacksPlan": {
      "phases": {
        "install": {
          "aptPkgs": [
            "ca-certificates",
            "fonts-dejavu-core",
            "fonts-liberation",
            "libatk-bridge2.0-0",
            "libatk1.0-0",
            "libatspi2.0-0",
            "libc6",
            "libcairo2",
            "libcups2",
            "libdbus-1-3",
            "libdrm2",
            "libexpat1",
            "libfontconfig1",
            "libfreetype6",
            "libgbm1",
            "libgcc1",
            "libglib2.0-0",
            "libgl1-mesa-glx",
            "libxcb1",
            "libx11-6",
            "libxcomposite1",
            "libxcursor1",
            "libxdamage1",
            "libxext6",
            "libxfixes3",
            "libxi6",
            "libxinerama1",
            "libxrandr2",
            "libxrender1",
            "libxshmfence1",
            "libxss1",
            "libxtst6",
            "libpango-1.0-0",
            "libpangocairo-1.0-0",
            "libpangoft2-1.0-0",
            "libnss3",
            "libnspr4",
            "libgtk-3-0",
            "libopengl0",
            "wget"
          ]
        }
      }
    }
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  }
}

